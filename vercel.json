{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/affiliate-portal",
      "destination": "/affiliate",
      "permanent": false
    },
    {
      "source": "/affiliate-portal.html",
      "destination": "/affiliate",
      "permanent": false
    },
    {
      "source": "/my-account",
      "destination": "https://admin.ambrosiastandard.com/my-account",
      "permanent": false
    },
    {
      "source": "/my-account/:path*",
      "destination": "https://admin.ambrosiastandard.com/my-account/:path*",
      "permanent": false
    },
    {
      "source": "/glow",
      "destination": "/ghk-cu-bpc-157-tb-500",
      "permanent": true
    },
    {
      "source": "/glow.html",
      "destination": "/ghk-cu-bpc-157-tb-500",
      "permanent": true
    },
    {
      "source": "/klow",
      "destination": "/ghk-cu-bpc-157-tb-500-kpv",
      "permanent": true
    },
    {
      "source": "/klow.html",
      "destination": "/ghk-cu-bpc-157-tb-500-kpv",
      "permanent": true
    },
    {
      "source": "/wolverine",
      "destination": "/bpc-157-tb-500",
      "permanent": true
    },
    {
      "source": "/wolverine.html",
      "destination": "/bpc-157-tb-500",
      "permanent": true
    },
    {
      "source": "/coa/wolverine-20mg.pdf",
      "destination": "/coa/bpc-157-tb-500-20mg.pdf",
      "permanent": true
    },
    {
      "source": "/coa/glow-70mg-090126GLOW70.pdf",
      "destination": "/coa/ghk-cu-bpc-157-tb-500-70mg-090126.pdf",
      "permanent": true
    },
    {
      "source": "/coa/klow-80mg.pdf",
      "destination": "/coa/ghk-cu-bpc-157-tb-500-kpv-80mg.pdf",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/order",
      "destination": "/order.dc"
    },
    {
      "source": "/admin-checkout",
      "destination": "/admin-checkout.dc"
    },
    {
      "source": "/login",
      "destination": "/login.dc"
    },
    {
      "source": "/checkout",
      "destination": "https://admin.ambrosiastandard.com/checkout"
    },
    {
      "source": "/checkout/:path*",
      "destination": "https://admin.ambrosiastandard.com/checkout/:path*"
    },
    {
      "source": "/order-received/:path*",
      "destination": "https://admin.ambrosiastandard.com/order-received/:path*"
    },
    {
      "source": "/wp-json/:path*",
      "destination": "https://admin.ambrosiastandard.com/wp-json/:path*"
    },
    {
      "source": "/wp-content/:path*",
      "destination": "https://admin.ambrosiastandard.com/wp-content/:path*"
    },
    {
      "source": "/wp-includes/:path*",
      "destination": "https://admin.ambrosiastandard.com/wp-includes/:path*"
    },
    {
      "source": "/wp-admin/admin-ajax.php",
      "destination": "https://admin.ambrosiastandard.com/wp-admin/admin-ajax.php"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|woff2|ttf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Vary",
          "value": "Cookie"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(order|admin-checkout|login)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/checkout",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/config/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
