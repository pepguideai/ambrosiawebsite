{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,

  "redirects": [
    { "source": "/checkout", "destination": "https://admin.ambrosiastandard.com/checkout", "permanent": false },
    { "source": "/checkout/:path*", "destination": "https://admin.ambrosiastandard.com/checkout/:path*", "permanent": false },
    { "source": "/order-received/:path*", "destination": "https://admin.ambrosiastandard.com/order-received/:path*", "permanent": false },
    { "source": "/my-account", "destination": "https://admin.ambrosiastandard.com/my-account", "permanent": false },
    { "source": "/my-account/:path*", "destination": "https://admin.ambrosiastandard.com/my-account/:path*", "permanent": false }
  ],

  "rewrites": [
    { "source": "/wp-json/:path*", "destination": "https://admin.ambrosiastandard.com/wp-json/:path*" },
    { "source": "/wp-content/:path*", "destination": "https://admin.ambrosiastandard.com/wp-content/:path*" },
    { "source": "/wp-includes/:path*", "destination": "https://admin.ambrosiastandard.com/wp-includes/:path*" },
    { "source": "/wp-admin/admin-ajax.php", "destination": "https://admin.ambrosiastandard.com/wp-admin/admin-ajax.php" }
  ],

  "headers": [
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|woff2|ttf)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
